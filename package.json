{
  "name": "goingboy",
  "productName": "GoingBoy",
  "version": "0.1.0",
  "description": "GoingBoy: a demo of human body movement - a stylized figure walks, squats, flips or dances and shows which joints, bones and muscles do the work; in the browser and as a desktop app",
  "author": "ALEXalesha",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://github.com/ALEXalesha/GoingBoy",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\"",
    "coverage": "c8 node --test --test-concurrency=1 \"tests/unit/*.test.js\" && node tools/coverage-check.js",
    "test:web": "playwright test --workers=1",
    "test:app": "playwright test --config=playwright.app.config.js --workers=1",
    "mutate": "node tools/mutate.js",
    "screens": "node tools/screenshots.js",
    "vendor": "node tools/build-vendor.js",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "c8": "10.1.3",
    "electron": "43.0.0",
    "three": "0.170.0"
  }
}
